{
  "name": "netflix-create-react-vite-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "build": "tsc -b && vite build",
    "format": "ultracite format",
    "biome:fix": "biome check --write --unsafe",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.105.3",
    "framer-motion": "14.9.1",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-http-backend": "^4.0.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "^1.64.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vite": "^8.3.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "npx ultracite format"
    ]
  }
}
